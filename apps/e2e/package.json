{
    "name": "@rumtelo/e2e",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Playwright smoke + plan-gating tests for the Rumtelo application",
    "scripts": {
        "test": "playwright test",
        "test:smoke": "playwright test --grep @smoke",
        "test:plan": "playwright test --grep @plan",
        "test:practice": "playwright test --grep @practice",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "report": "playwright show-report",
        "install:browsers": "playwright install chromium"
    },
    "devDependencies": {
        "@playwright/test": "^1.52.0",
        "@rumtelo/typescript-config": "workspace:*",
        "@types/node": "26.3.0",
        "dotenv": "^17.4.1",
        "typescript": "5.9.3"
    }
}
