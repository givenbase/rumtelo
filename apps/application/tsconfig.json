{
    "extends": "@rumtelo/typescript-config/nextjs.json",
    "compilerOptions": {
        "plugins": [
            {
                "name": "next"
            }
        ],
        "strictNullChecks": true,
        "paths": {
            "@/*": ["./*"],
            "@/app/*": ["./app/*"],
            "@/components/*": ["./app/_components/*"],
            "@/product/*": ["./app/(routes)/[locale]/(app)/(household)/product/*"],
            "@/household/*": ["./app/(routes)/[locale]/(app)/(household)/*"],
            "@/practice/*": ["./app/(routes)/[locale]/(app)/practice/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", "next.config.js", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
}
