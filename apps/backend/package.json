{
    "name": "@rumtelo/backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "build": "nest build",
        "start": "tsx src/main.ts",
        "start:node": "node dist/src/main.js",
        "lint": "pnpm lint:entities",
        "lint:entities": "tsx scripts/lint/check-entity-style.ts",
        "docs:entities": "tsx scripts/docs/entity-inventory.ts",
        "check-types": "tsc --noEmit",
        "test": "vitest run",
        "db:gen": "NODE_OPTIONS='--import tsx' mikro-orm migration:create --config ./mikro-orm.config.ts",
        "db:push": "pnpm --filter @rumtelo/contracts build && tsx scripts/db/migration-up.ts",
        "db:migrate": "pnpm db:push",
        "db:create": "pnpm db:gen",
        "db:create-schemas": "tsx scripts/db/create-schemas.ts",
        "db:drop": "tsx scripts/db/drop-schema-cascade.ts",
        "db:reset": "tsx scripts/db/reset-migrations.ts",
        "db:fresh": "tsx scripts/db/drop-schema-cascade.ts -- --yes && pnpm db:create-schemas && pnpm db:push && pnpm auth:migrate && pnpm db:seed",
        "db:seed": "pnpm --filter @rumtelo/contracts build && tsx scripts/db/seeder-run.ts",
        "schema:drop": "tsx scripts/db/drop-schema-cascade.ts",
        "schema:drop:cascade": "tsx scripts/db/drop-schema-cascade.ts",
        "schema:drop:db": "tsx scripts/db/drop-database.ts",
        "schema:fresh": "pnpm schema:drop:cascade -- --yes && pnpm db:create-schemas && pnpm db:push",
        "auth:migrate": "tsx ./src/modules/auth/engine/auth.migrate.ts",
        "stripe:seed-plans": "tsx scripts/stripe/seed-plans.ts"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "11.3.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/static": "^10.1.3",
        "@mikro-orm/core": "^6.6.3",
        "@mikro-orm/migrations": "^6.6.3",
        "@mikro-orm/nestjs": "^6.1.1",
        "@mikro-orm/postgresql": "^6.6.3",
        "@mikro-orm/reflection": "^6.6.3",
        "@mikro-orm/seeder": "^6.6.3",
        "@nest-lab/throttler-storage-redis": "^1.2.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.1",
        "@nestjs/platform-fastify": "^11.0.1",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/throttler": "^6.5.0",
        "@orpc/client": "1.13.0",
        "@orpc/contract": "1.13.0",
        "@orpc/json-schema": "^1.13.0",
        "@orpc/nest": "1.13.0",
        "@orpc/openapi": "^1.13.0",
        "@orpc/server": "1.13.0",
        "@orpc/zod": "^1.13.0",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.1.0",
        "@rumtelo/brand": "workspace:*",
        "@rumtelo/contracts": "workspace:*",
        "@rumtelo/utils": "workspace:*",
        "@thallesp/nestjs-better-auth": "^2.4.0",
        "better-auth": "^1.5.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "date-fns": "^4.4.0",
        "date-fns-tz": "^3.2.0",
        "fastify": "5.11.3",
        "ioredis": "^5.10.1",
        "pg": "^8.13.1",
        "react": "^19.2.8",
        "reflect-metadata": "^0.2.2",
        "resend": "^6.26.0",
        "rxjs": "^7.8.1",
        "stripe": "^22.6.1",
        "uuid": "^11.0.5",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@mikro-orm/cli": "^6.6.3",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@rumtelo/typescript-config": "workspace:*",
        "@types/node": "26.3.0",
        "@types/pg": "^8.11.10",
        "@types/react": "^19.2.18",
        "dotenv": "^17.4.1",
        "tsx": "^4.23.13",
        "typescript": "5.9.3",
        "vitest": "^3.2.4"
    },
    "mikro-orm": {
        "configPaths": [
            "./mikro-orm.config.ts",
            "./dist/mikro-orm.config.js"
        ]
    }
}
