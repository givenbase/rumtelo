# ============================================================================
#           💰 RUMTELO BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================================
# Template for `@rumtelo/backend` (NestJS + oRPC + Better Auth).
#
# Key names match the Railway Backend service. Local development usually uses
# the monorepo root `.env`:
#   cp ../../.env.example ../../.env
#
# For Railway / isolated deploys, copy this file next to the service and fill
# values, or set the same keys in the Railway dashboard.
#
# ⚠️  SECURITY WARNING: Never commit a filled `.env` to version control!
# ============================================================================


# ============================================================================
# 🚀 1. RUNTIME
# ============================================================================

NODE_ENV=development
# Energy/Soul deferred only when NODE_ENV=production.
# Local seed: `pnpm db:seed:prod` → production; `pnpm db:seed:stag` → staging.
PORT=3002
LOG_LEVEL=debug


# ============================================================================
# 🌐 2. DOMAINS
# ============================================================================
# Railway (no www):
#   DOMAIN_APP         = https://app.rumtelo.com
#   DOMAIN_WEB         = https://rumtelo.com
#   DOMAIN_BACK        = http://${{Backend.RAILWAY_PRIVATE_DOMAIN}}:${{Backend.PORT}}
#     (${{Backend.PORT}} is empty unless you set PORT manually on Backend, e.g. PORT=8080)
#   DOMAIN_BACK_PUBLIC = https://${{Backend.RAILWAY_PUBLIC_DOMAIN}}
# Private = http + PORT (no TLS on the mesh). Public = https.
# Session cookie Domain from DOMAIN_WEB / DOMAIN_APP (crossSubDomainCookies).
# Staging/prod: use brand hosts (dev.rumtelo.com / app.rumtelo.com), not Railway defaults.
# Local: private + public are the same origin.

DOMAIN_APP=http://localhost:3000
DOMAIN_WEB=http://localhost:3001
DOMAIN_BACK=http://localhost:3002
DOMAIN_BACK_PUBLIC=http://localhost:3002


# ============================================================================
# 🗄️  3. DATABASE
# ============================================================================

# --- PostgreSQL ---
# postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://rumtelo:rumtelo@localhost:5432/rumtelo

# String "true" / "false". Required true on Railway managed Postgres.
DATABASE_SSL=false

# Must stay false — schema changes via migrations only (validated on boot).
DATABASE_SYNC=false

# --- Redis (optional locally) ---
# Was REDIS_URL. Prefer redis:// / rediss:// (not https://).
DATABASE_REDIS_URL=redis://localhost:6379


# ============================================================================
# 🔐 4. AUTHENTICATION
# ============================================================================

# ≥ 32 characters. Signs every session cookie.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters

# When true, Better Auth requires email verification before sign-in.
EMAIL_VERIFICATION_ENABLED=false


# ============================================================================
# ✉️  5. EMAIL
# ============================================================================

EMAIL_PROVIDER=memory
RESEND_API_KEY=
# When true, never call the provider — log only.
EMAIL_LOG_ONLY=false
EMAIL_FROM="Rumtelo <info@rumtelo.app>"


# ============================================================================
# 💳 6. PAYMENTS (optional)
# ============================================================================
# When STRIPE_SECRET_KEY is set, Plus/Max upgrades go through Checkout.
# When unset, paid upgrades are blocked — households stay on Basic (no free upgrade).
# For local free plan switching only, set BILLING_PREVIEW_BYPASS=true.
# Create Products/Prices once per Stripe account (test + live):
#   pnpm stripe:seed-plans:stag | pnpm stripe:seed-plans:prod
# Billing resolves prices via lookup keys (rumtelo_plus_monthly, …) — no price_… IDs in env.
#
# Webhook: POST {DOMAIN_BACK_PUBLIC}/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
# true = allow free plan switches without Checkout (local/preview only; pair with NEXT_PUBLIC_PREVIEW_MODE)
BILLING_PREVIEW_BYPASS=false

# Backend maintenance flag — exposed on /health (Next uses NEXT_PUBLIC_MAINTENANCE)
MAINTENANCE=false


# ============================================================================
# 🤖 7. AI / MAPS (optional)
# ============================================================================

OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_MAPS_API=


# ============================================================================
# 🏦 8. BANK SYNC (optional — off by default)
# ============================================================================
# CSV import works without this. Live sync needs FEATURE_BANK_SYNC=true plus
# Enable Banking credentials (sandbox / restricted production).
# Strategy, NL coverage, pricing: docs/engineering/banking.md
#
# Control Panel redirect URLs (exact, no query string):
#   http://localhost:3000/banking/callback
#   https://app.rumtelo.com/banking/callback
#
# APP_ID = UUID from Control Panel (= .pem filename without extension).
# PRIVATE_KEY = PEM on ONE line in quotes, newlines as \n (dotenv does not
# keep multi-line values — a broken key only loads the BEGIN header and
# startLink returns bank_sync_failed).
# Example:
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"

FEATURE_BANK_SYNC=false
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=


# ============================================================================
# 📈 9. MONITORING / DEV SURFACES (optional — not required on Railway)
# ============================================================================

SENTRY_DSN=
# On in development by default. Outside development set true to expose /api/docs.
ENABLE_SWAGGER=


# ============================================================================
# 📝 ADDITIONAL NOTES
# ============================================================================
#
# 🚀 Local:
#   1. Prefer monorepo root `.env` (loaded via `loadEnvFiles` — never overrides process.env)
#   2. pnpm infra:up && pnpm db:migrate && pnpm auth:migrate
#   3. pnpm --filter @rumtelo/backend dev
#
# ✅ Production (Railway):
#   ✓ Set vars on the Backend service (no .env in the image — gitignored)
#   ✓ NODE_ENV=production + DATABASE_SSL=true + DATABASE_SYNC=false
#   ✓ Unique BETTER_AUTH_SECRET per environment
#   ✓ DOMAIN_BACK = http://….railway.internal:PORT (private)
#   ✓ DOMAIN_BACK_PUBLIC = https://… (public)
#   ✓ DOMAIN_APP / DOMAIN_WEB on HTTPS public origins
#   ✓ EMAIL_VERIFICATION_ENABLED=true when ready
#
# 📋 Validated by: apps/backend/src/common/config/env.config.ts
#
# ============================================================================
