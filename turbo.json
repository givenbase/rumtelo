{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "globalDependencies": ["**/.env.*local", ".env"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
            "env": [
                "NODE_ENV",
                "PORT",
                "LOG_LEVEL",
                "DATABASE_URL",
                "DATABASE_SSL",
                "DATABASE_SYNC",
                "DATABASE_REDIS_URL",
                "BETTER_AUTH_SECRET",
                "EMAIL_VERIFICATION_ENABLED",
                "DOMAIN_APP",
                "DOMAIN_WEB",
                "DOMAIN_BACK",
                "DOMAIN_BACK_PUBLIC",
                "NEXT_PUBLIC_DOMAIN_APP",
                "NEXT_PUBLIC_DOMAIN_WEB",
                "NEXT_PUBLIC_DOMAIN_BACK",
                "NEXT_PUBLIC_MAINTENANCE",
                "MAINTENANCE",
                "FEATURE_BANK_SYNC",
                "ENABLE_BANKING_APP_ID",
                "ENABLE_BANKING_PRIVATE_KEY",
                "STRIPE_SECRET_KEY",
                "STRIPE_WEBHOOK_SIGNING_SECRET",
                "BILLING_PREVIEW_BYPASS",
                "OPENAI_API_KEY",
                "OPENAI_MODEL",
                "GOOGLE_MAPS_API",
                "SENTRY_DSN",
                "ENABLE_SWAGGER",
                "EMAIL_PROVIDER",
                "EMAIL_FROM",
                "EMAIL_LOG_ONLY",
                "RESEND_API_KEY"
            ]
        },
        "dev": { "cache": false, "persistent": true, "dependsOn": ["^build"] },
        // Watch reuses the same dist/ as build — never race them (ENOENT on unlink).
        "@rumtelo/contracts#dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["build"]
        },
        "start": { "dependsOn": ["^build"], "cache": false, "persistent": true },
        "lint": {
            "cache": false
        },
        "check-types": { "dependsOn": ["^build"] },
        "test": { "dependsOn": ["^build"] },
        "clean": { "cache": false }
    }
}
