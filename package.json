{
    "name": "rumtelo",
    "version": "0.1.0",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/givenbase/rumtelo.git"
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "turbo run build --output-logs=errors-only",
        "build:application": "turbo run build --filter=@rumtelo/application...",
        "build:website": "turbo run build --filter=@rumtelo/website...",
        "build:backend": "turbo run build --filter=@rumtelo/backend...",
        "build:packages": "turbo run build --filter=./packages/*",
        "start": "turbo run start",
        "start:application": "pnpm --filter @rumtelo/application start",
        "start:website": "pnpm --filter @rumtelo/website start",
        "start:backend": "pnpm --filter @rumtelo/backend start",
        "start:backend:node": "pnpm --filter @rumtelo/backend start:node",
        "dev": "turbo run dev",
        "dev:app": "turbo run dev --filter=@rumtelo/application --filter=@rumtelo/backend --filter=./packages/*",
        "dev:web": "turbo run dev --filter=@rumtelo/website --filter=@rumtelo/backend --filter=./packages/*",
        "dev:back": "turbo run dev --filter=@rumtelo/backend --filter=./packages/*",
        "lint": "oxlint --fix . && oxfmt . && pnpm --filter @rumtelo/backend run lint:entities && pnpm check-types",
        "lint:check": "oxlint . && oxfmt --check . && pnpm --filter @rumtelo/backend run lint:entities && pnpm check-types",
        "lint:style": "oxlint --fix . && oxfmt . && pnpm --filter @rumtelo/backend run lint:entities",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "check-types": "turbo run check-types",
        "test": "turbo run test",
        "test:e2e": "pnpm --filter @rumtelo/e2e test",
        "test:e2e:smoke": "pnpm --filter @rumtelo/e2e test:smoke",
        "test:e2e:plan": "pnpm --filter @rumtelo/e2e test:plan",
        "clean": "rm -rf .turbo apps/*/.turbo packages/*/.turbo node_modules apps/*/node_modules packages/*/node_modules apps/*/.next packages/*/dist apps/*/dist apps/backend/temp apps/backend/src/database/.temp && pnpm store prune && pnpm install",
        "infra:up": "docker compose -f devops/docker-compose.dev.yml up -d",
        "infra:down": "docker compose -f devops/docker-compose.dev.yml down",
        "db:gen": "pnpm --filter @rumtelo/backend run db:gen",
        "i18n:gen": "pnpm --filter @rumtelo/i18n generate && pnpm --filter @rumtelo/i18n translate:nl",
        "i18n:generate": "pnpm --filter @rumtelo/i18n generate",
        "i18n:translate:nl": "pnpm --filter @rumtelo/i18n translate:nl",
        "db:push": "pnpm --filter @rumtelo/backend run db:push",
        "db:migrate": "pnpm --filter @rumtelo/backend run db:push",
        "db:drop": "pnpm --filter @rumtelo/backend run db:drop",
        "db:reset": "pnpm --filter @rumtelo/backend run db:reset",
        "db:fresh": "pnpm --filter @rumtelo/backend run db:fresh",
        "db:seed": "pnpm --filter @rumtelo/backend run db:seed",
        "auth:migrate": "pnpm --filter @rumtelo/backend run auth:migrate",
        "stripe:seed-plans": "pnpm --filter @rumtelo/backend run stripe:seed-plans",
        "stripe:seed-plans:stag": "NODE_ENV=staging pnpm stripe:seed-plans",
        "stripe:seed-plans:prod": "NODE_ENV=production pnpm stripe:seed-plans",
        "api:smoke": "node ./scripts/api-smoke.mjs",
        "env:use": "node scripts/use-env.js",
        "env:use:staging": "node scripts/use-env.js staging",
        "env:use:production": "node scripts/use-env.js production",
        "db:push:stag": "NODE_ENV=staging pnpm db:push",
        "db:push:prod": "NODE_ENV=production pnpm db:push",
        "db:seed:stag": "NODE_ENV=staging pnpm db:seed",
        "db:seed:prod": "NODE_ENV=production pnpm db:seed",
        "db:reset:stag": "NODE_ENV=staging pnpm db:fresh",
        "db:reset:prod": "NODE_ENV=production pnpm db:fresh",
        "db:drop:stag": "NODE_ENV=staging pnpm db:drop",
        "db:drop:prod": "NODE_ENV=production pnpm db:drop",
        "sync:github-secrets": "node scripts/sync-github-secrets.js",
        "sync:github-secrets:init": "node scripts/sync-github-secrets.js --init",
        "sync:github-secrets:staging": "node scripts/sync-github-secrets.js --staging",
        "sync:github-secrets:production": "node scripts/sync-github-secrets.js --production",
        "rename": "node scripts/rename-project.mjs",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "oxlint-tsgolint": "^7.0.2001",
        "turbo": "^2.10.12",
        "typescript": "5.9.3"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ],
        "overrides": {
            "fastify": "5.11.3"
        }
    }
}
