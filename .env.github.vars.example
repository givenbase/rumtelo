# =============================================================================
# GitHub Environment VARIABLES — template (no secrets)
# =============================================================================
# After init, edit these gitignored files (repo root):
#   .env.github.vars.staging
#   .env.github.vars.production
#
# Commands:
#   pnpm sync:github-secrets:init
#   pnpm sync:github-secrets
#
# Hint — .env.github.vars.staging (galighticus-style custom domains under brand root):
#   DATABASE_SSL=true
#   DOMAIN_WEB=https://dev.rumtelo.com
#   DOMAIN_APP=https://dev-app.rumtelo.com
#   DOMAIN_BACK=https://backend.railway.internal   # private mesh for Next→Nest
#   DOMAIN_BACK_PUBLIC=https://dev-backend.rumtelo.com
#   NEXT_PUBLIC_DOMAIN_WEB / _APP / _BACK = same public HTTPS origins
#
# Hint — .env.github.vars.production:
#   DOMAIN_WEB=https://rumtelo.com
#   DOMAIN_APP=https://app.rumtelo.com
#   DOMAIN_BACK_PUBLIC=https://backend.rumtelo.com
#
# Cross-subdomain cookies: Better Auth derives Domain from DOMAIN_WEB/APP
# (e.g. .rumtelo.com). Do NOT point staging DOMAIN_* at *.up.railway.app —
# that breaks shared cookies (and login). Attach custom domains in Railway first.
#
# Backend NODE_ENV in GitHub Actions is always `production` (see resolve-deploy-environment).
# Do not set NODE_ENV=development here.
# Launch surface: Energy/Soul deferred when NODE_ENV=production (no APP_ENV).
# Maintenance (set per service — not aliases of each other):
#   MAINTENANCE=true                 # Backend → /health
#   NEXT_PUBLIC_MAINTENANCE=true     # Application + Website builds
# Staging banner: NODE_ENV=staging on Application + Website (+ Backend as needed)
# =============================================================================

# ── REQUIRED — db-migrate.yml + api-smoke + e2e ──────────────────────────────
DOMAIN_APP=
DOMAIN_WEB=
DOMAIN_BACK=
DOMAIN_BACK_PUBLIC=
DATABASE_SSL=true

# ── Maintenance (optional) ────────────────────────────────────────────────────
# MAINTENANCE=false
# NEXT_PUBLIC_MAINTENANCE=false

# ── Optional — Next public mirrors (required on Railway for Next builds) ────
# NEXT_PUBLIC_DOMAIN_APP=
# NEXT_PUBLIC_DOMAIN_WEB=
# NEXT_PUBLIC_DOMAIN_BACK=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_PREVIEW_MODE=
# NEXT_PUBLIC_PREVIEW_PLAN=
